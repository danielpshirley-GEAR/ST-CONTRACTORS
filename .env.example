# =============================================================================
# APEX / ST CONTRACTORS CONSTRUCTION PLATFORM — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and populate the secrets for your environment.
# Never commit real credentials or .env.local to Git.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & AUTHENTICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

ADMIN_PASSWORD=ApexAdmin2026!Secure
ADMIN_SECRET_KEY=change-this-to-a-random-32-character-secret-in-production
DATABASE_URL=file:./dev.db


# ============================================
# GOOGLE OAUTH
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Production example:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback


# ============================================
# GOOGLE SEARCH CONSOLE
# ============================================

GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:yourdomain.com


# ============================================
# GOOGLE ANALYTICS 4
# ============================================

GA4_PROPERTY_ID=


# ============================================
# DATAFORSEO
# ============================================

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# During development Antigravity should optionally use:
# https://sandbox.dataforseo.com


# ============================================
# GOOGLE PAGESPEED
# ============================================

PAGESPEED_API_KEY=


# ============================================
# GOOGLE MAPS / GEOCODING
# ============================================

GOOGLE_MAPS_API_KEY=


# ============================================
# GEMINI
# ============================================

GEMINI_API_KEY=


# ============================================
# GOOGLE BUSINESS PROFILE
# ============================================

GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=

# Keep disabled until GBP API approval/access succeeds
GBP_ENABLED=false
